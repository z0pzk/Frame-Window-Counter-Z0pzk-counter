{
    "geode": "5.11.2",
    "gd": {
        "win": "2.2081",
        "android": "2.2081",
        "mac": "2.2081",
        "ios": "2.2081"
    },
    "id": "z0pzk.frame-window-counter",
    "name": "Frame Window Counter",
    "version": "v10.3.2",
    "developer": "z0pzk",
    "description": "Frame & CBF Window Counter v10.3 — fixes Ball/BlueOrb/GreenOrb gravity flip impulse sign, adds Gravity Portals / Jump Pads / Gamemode Portals & circular Sawblade hitboxes to Auto physics, prevents early 100.00% clamping, and fixes Scan Exact stopping after 1 click.",
    "resources": {
        "files": [
            "resources/*.wav",
            "resources/*.png"
        ]
    },
    "settings": {
        "enabled": {
            "type": "bool",
            "name": "Enable Mod",
            "default": true
        },
        "mode": {
            "type": "string",
            "name": "Counter Mode",
            "default": "auto",
            "one-of": [
                "auto",
                "manual"
            ]
        },
        "ref-fps": {
            "type": "int",
            "name": "Reference FPS",
            "default": 240,
            "min": 30,
            "max": 100000
        },
        "cbf-mode": {
            "type": "bool",
            "name": "CBF Decimals",
            "default": true
        },
        "table-style": {
            "type": "string",
            "name": "Table Tier Style",
            "default": "topdown24",
            "one-of": [
                "topdown24",
                "cbf",
                "discrete"
            ]
        },
        "show-circles": {
            "type": "bool",
            "name": "Show Click Circles",
            "default": true
        },
        "persistent-circles": {
            "type": "bool",
            "name": "Keep Circles",
            "default": true
        },
        "circle-scale": {
            "type": "float",
            "name": "Circle Size",
            "default": 1.0,
            "min": 0.4,
            "max": 2.5
        },
        "ring-thickness": {
            "type": "string",
            "name": "Ring Thickness",
            "default": "bold",
            "one-of": [
                "thin",
                "bold",
                "thick"
            ]
        },
        "show-circle-label": {
            "type": "bool",
            "name": "Show Numbers Next to Circles",
            "default": true
        },
        "show-tier-table": {
            "type": "bool",
            "name": "Show Top-Left Tier Table",
            "default": true
        },
        "hud-scale": {
            "type": "float",
            "name": "HUD Text Scale",
            "default": 1.35,
            "min": 0.7,
            "max": 2.0
        },
        "show-ms-hz": {
            "type": "bool",
            "name": "Show Reaction ms & Hz",
            "default": true
        },
        "show-bottom-stats": {
            "type": "bool",
            "name": "Show Bottom-Left Difficulty % & Score",
            "default": true
        },
        "show-watermark": {
            "type": "bool",
            "name": "Show Top-Center Watermark",
            "default": true
        },
        "watermark-text": {
            "type": "string",
            "name": "Watermark Text",
            "default": "FWC COUNTER"
        },
        "show-auto-comments": {
            "type": "bool",
            "name": "Show Auto Callout Comments",
            "default": true
        },
        "comment-fade-sec": {
            "type": "float",
            "name": "Comment Fade Time (sec)",
            "default": 2.4,
            "min": 0.5,
            "max": 8.0
        },
        "banner-mode": {
            "type": "string",
            "name": "Intro Screen Mode",
            "default": "first",
            "one-of": [
                "off",
                "first",
                "always"
            ]
        },
        "intro-freeze": {
            "type": "bool",
            "name": "Freeze Game on Frame 0 During Intro",
            "default": true
        },
        "banner-duration": {
            "type": "float",
            "name": "Intro Duration (sec)",
            "default": 2.6,
            "min": 0.8,
            "max": 8.0
        },
        "banner-comment": {
            "type": "string",
            "name": "Intro Subtitle",
            "default": ""
        },
        "raw-precision-text": {
            "type": "string",
            "name": "Intro Bottom Line",
            "default": ""
        },
        "sound-enabled": {
            "type": "bool",
            "name": "Enable Bell Sound",
            "default": true
        },
        "sound-preset": {
            "type": "string",
            "name": "Bell Preset",
            "default": "classic",
            "one-of": [
                "classic",
                "fb",
                "chime",
                "tick",
                "custom"
            ]
        },
        "custom-sound-file": {
            "type": "string",
            "name": "Custom Sound File",
            "default": ""
        },
        "sound-volume": {
            "type": "float",
            "name": "Bell Volume",
            "default": 0.75,
            "min": 0.0,
            "max": 1.0
        },
        "sound-pitch": {
            "type": "float",
            "name": "Bell Base Pitch",
            "default": 1.0,
            "min": 0.4,
            "max": 2.5
        },
        "dynamic-pitch": {
            "type": "bool",
            "name": "Auto Pitch by Tightness",
            "default": true
        },
        "capture-to-manual": {
            "type": "bool",
            "name": "Capture Clicks to Manual",
            "default": false
        },
        "render-fps": {
            "type": "int",
            "name": "Render Video FPS",
            "default": 60,
            "min": 24,
            "max": 120
        },
        "render-res": {
            "type": "string",
            "name": "Render Resolution",
            "default": "720p",
            "one-of": [
                "window",
                "720p",
                "1080p"
            ]
        },
        "render-bitrate": {
            "type": "string",
            "name": "Render Bitrate",
            "default": "12M",
            "one-of": [
                "8M",
                "12M",
                "25M"
            ]
        }
    }
}

{
    "geode": "5.11.2",
    "gd": {
        "win": "2.2081",
        "android": "2.2081",
        "mac": "2.2081",
        "ios": "2.2081"
    },
    "id": "z0pzk.frame-window-counter",
    "name": "Frame Window Counter",
    "version": "v4.0.0",
    "developer": "z0pzk",
    "description": "Frame & CBF Window Counter with survival-peak Auto physics analyzer, Manual markers & comments, bold static click circles, glowing tier table, and full bot compatibility (Silicate, xdBot, Eclipse, CBF).",
    "resources": {
        "files": [
            "resources/*.wav",
            "resources/*.png"
        ]
    },
    "settings": {
        "enabled": {
            "type": "bool",
            "name": "Enable Mod",
            "default": true
        },
        "mode": {
            "type": "string",
            "name": "Counter Mode",
            "default": "auto",
            "one-of": [
                "auto",
                "manual"
            ]
        },
        "ref-fps": {
            "type": "int",
            "name": "Reference FPS",
            "default": 240,
            "min": 30,
            "max": 100000
        },
        "cbf-mode": {
            "type": "bool",
            "name": "CBF Decimals",
            "default": true
        },
        "table-style": {
            "type": "string",
            "name": "Table Tier Style",
            "default": "cbf",
            "one-of": [
                "cbf",
                "discrete"
            ]
        },
        "show-circles": {
            "type": "bool",
            "name": "Show Click Circles",
            "default": true
        },
        "persistent-circles": {
            "type": "bool",
            "name": "Keep Circles",
            "default": true
        },
        "circle-scale": {
            "type": "float",
            "name": "Circle Size",
            "default": 1.0,
            "min": 0.4,
            "max": 2.5
        },
        "ring-thickness": {
            "type": "string",
            "name": "Ring Thickness",
            "default": "bold",
            "one-of": [
                "thin",
                "bold",
                "thick"
            ]
        },
        "show-circle-label": {
            "type": "bool",
            "name": "Show Numbers Next to Circles",
            "default": true
        },
        "show-tier-table": {
            "type": "bool",
            "name": "Show Top-Left Tier Table",
            "default": true
        },
        "show-ms-hz": {
            "type": "bool",
            "name": "Show Reaction ms & Hz",
            "default": true
        },
        "show-bottom-stats": {
            "type": "bool",
            "name": "Show Bottom-Left % & Score",
            "default": true
        },
        "show-watermark": {
            "type": "bool",
            "name": "Show Top-Center Watermark",
            "default": true
        },
        "watermark-text": {
            "type": "string",
            "name": "Watermark Text",
            "default": "FWC COUNTER"
        },
        "comment-fade-sec": {
            "type": "float",
            "name": "Manual Comment Fade (sec)",
            "default": 2.2,
            "min": 0.5,
            "max": 8.0
        },
        "banner-mode": {
            "type": "string",
            "name": "Intro Screen Mode",
            "default": "first",
            "one-of": [
                "off",
                "first",
                "always"
            ]
        },
        "banner-duration": {
            "type": "float",
            "name": "Intro Duration (sec)",
            "default": 2.8,
            "min": 0.8,
            "max": 8.0
        },
        "banner-comment": {
            "type": "string",
            "name": "Intro Subtitle",
            "default": ""
        },
        "raw-precision-text": {
            "type": "string",
            "name": "Intro Bottom Line",
            "default": ""
        },
        "sound-enabled": {
            "type": "bool",
            "name": "Enable Bell Sound",
            "default": true
        },
        "sound-preset": {
            "type": "string",
            "name": "Bell Preset",
            "default": "classic",
            "one-of": [
                "classic",
                "fb",
                "chime",
                "tick",
                "custom"
            ]
        },
        "custom-sound-file": {
            "type": "string",
            "name": "Custom Sound File",
            "default": ""
        },
        "sound-volume": {
            "type": "float",
            "name": "Bell Volume",
            "default": 0.75,
            "min": 0.0,
            "max": 1.0
        },
        "sound-pitch": {
            "type": "float",
            "name": "Bell Base Pitch",
            "default": 1.0,
            "min": 0.4,
            "max": 2.5
        },
        "dynamic-pitch": {
            "type": "bool",
            "name": "Auto Pitch by Tightness",
            "default": true
        },
        "capture-to-manual": {
            "type": "bool",
            "name": "Capture Clicks to Manual",
            "default": false
        }
    }
}